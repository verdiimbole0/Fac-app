DATABASE_URL="postgresql://user:password@localhost:5432/facapp"
JWT_SECRET="change-me-to-a-long-random-secret"
PORT=4000

# Origines autorisées pour le CORS en production, séparées par des virgules
# (ex: https://facapp.vercel.app). Vide = toutes les origines (développement).
CORS_ORIGIN=

# Stockage des documents de la messagerie : "local" (défaut, dossier uploads/)
# ou "s3" (tout service compatible S3 : AWS S3, Supabase Storage, Cloudflare R2...)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# À compléter une fois les accès obtenus auprès de chaque provider
ORANGE_MONEY_API_KEY=
AIRTEL_MONEY_API_KEY=
MPESA_API_KEY=
FONDEKA_API_KEY=
